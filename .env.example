APP_ENV=development
DATABASE_URL=postgresql+asyncpg://ideas:ideas@postgres:5432/ideas
REDIS_URL=redis://redis:6379/0
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=ideas-hub
MINIO_SECURE=false

# Local-first model defaults. Use host.docker.internal if the model server runs on the host.
LOCAL_LLM_BASE_URL=http://host.docker.internal:8001/v1
LOCAL_LLM_API_KEY=local
LOCAL_LLM_MODEL=Qwen/Qwen3-14B-AWQ

OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-4
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

TASK_ARTICLE_EXTRACT_PROVIDER=local
TASK_EVENT_SUMMARY_PROVIDER=local
TASK_OPPORTUNITY_GENERATE_PROVIDER=local
TASK_OPPORTUNITY_SKEPTIC_PROVIDER=local
TASK_OPPORTUNITY_JUDGE_PROVIDER=local

EMBEDDING_MODEL=BAAI/bge-m3
EVENT_SIMILARITY_THRESHOLD=0.82
SIGNAL_OPPORTUNITY_THRESHOLD=50
CLOUD_FALLBACK_ENABLED=false

# Seed starter RSS sources and crawl them in the background every 30 minutes.
SEED_DEFAULT_SOURCES=true
CRAWL_INTERVAL_MINUTES=30
CRAWL_LIMIT=10
SOURCE_DISCOVERY_INTERVAL_HOURS=24
SOURCE_DISCOVERY_ARTICLE_LIMIT=200
SOURCE_AUTO_APPROVE_SCORE=85
SOURCE_BOOTSTRAP_LIMIT=3
WORKER_CONCURRENCY=2

NEXT_PUBLIC_API_URL=http://localhost:8888
NEXT_PUBLIC_BROWSER_API_URL=http://localhost:8888
